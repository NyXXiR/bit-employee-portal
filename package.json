{
  "name": "bit-employee-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <21"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
