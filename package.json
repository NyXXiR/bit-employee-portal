    "measure": "tsx scripts/measure-background-check.ts",
    "measure:analyze": "tsx scripts/analyze-measurements.ts",
    "measure:validate": "tsx scripts/validate-retry-policy.ts",
    "submit:collect": "tsx scripts/collect-submission.ts"
  },
  "dependencies": {
